# Supabase — veja em Project Settings > API no seu projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL final do site (usada em SEO/Open Graph e nos links de redirecionamento)
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br


# WhatsApp Business Platform Cloud API (opcional — só para mensagens a
# contatos com opt-in; não publica no canal). Veja developers.facebook.com
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Segredo usado pela Vercel para chamar a rotina de publicação agendada
CRON_SECRET=

# Segredo aleatório para tornar os avisos de promoção resistentes a manipulação
REPORT_FINGERPRINT_SALT=

# Google Analytics 4 (opcional, recomendado para demografia agregada)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console — use apenas o token da meta tag de verificação
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Leitura de idade/gênero do GA4 dentro do painel administrativo (opcional)
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# SEO de marca / perfis oficiais (opcional, recomendado)
# Cole as URLs completas dos perfis oficiais. Elas alimentam o rodapé e o sameAs do Schema.org.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/0029VbDCazP2UPBJKKFNVo3J
